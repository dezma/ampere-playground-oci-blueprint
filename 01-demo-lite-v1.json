{
  "blueprint_category": "model_serving",
  "blueprint_type": "community_blueprint",
  "blueprint_title": "Ampere AI Playground Demo Lite V1 on OCI",
  "blueprint_short_description": "YOLO, Whisper, Ollama, and Open WebUI on a fresh OCI Ampere shared pool.",
  "deployment_group": {
    "name": "ampere-demo-lite-v1",
    "deployments": [
      {
        "name": "ampere-demo-lite-pool-v1",
        "recipe": {
          "recipe_mode": "shared_node_pool",
          "deployment_name": "ampere-demo-lite-pool-v1",
          "shared_node_pool_selector": "ampere-demo-lite-v1",
          "shared_node_pool_shape": "VM.Standard.A2.Flex",
          "shared_node_pool_size": 1,
          "shared_node_pool_flex_shape_ocpu_count": 32,
          "shared_node_pool_flex_shape_memory_size_in_gbs": 256,
          "shared_node_pool_boot_volume_size_in_gbs": 500
        }
      },
      {
        "name": "yolo",
        "depends_on": [
          "ampere-demo-lite-pool-v1"
        ],
        "exports": [
          "service_url",
          "service_name",
          "internal_dns_name"
        ],
        "recipe": {
          "recipe_id": "ampere_yolov11_demo_v1",
          "recipe_mode": "service",
          "deployment_name": "ampere-demo-yolov11-v1",
          "recipe_image_uri": "ghcr.io/amperecomputingai/ampere-ai-ref-apps:yolov11-0.3.10",
          "recipe_node_shape": "VM.Standard.A2.Flex",
          "recipe_node_selector_arch": "arm64",
          "recipe_use_shared_node_pool": true,
          "recipe_shared_node_pool_selector": "ampere-demo-lite-v1",
          "recipe_container_port": "7862",
          "recipe_host_port": "80",
          "recipe_replica_count": 1,
          "recipe_container_cpu_count": 4,
          "recipe_container_memory_size": 24,
          "recipe_ephemeral_storage_size": 20,
          "recipe_shared_memory_volume_size_limit_in_mb": 1024,
          "recipe_container_env": [
            {
              "key": "CONFIG_FILE",
              "value": "cfg/config.yaml"
            },
            {
              "key": "GRADIO_SERVER_NAME",
              "value": "0.0.0.0"
            },
            {
              "key": "GRADIO_SERVER_PORT",
              "value": "7862"
            },
            {
              "key": "HOST_PORT",
              "value": "7862"
            },
            {
              "key": "INSTANCE_NAME",
              "value": "OCI Ampere"
            },
            {
              "key": "NSTREAMS",
              "value": "1"
            },
            {
              "key": "NTHREADS",
              "value": "16"
            },
            {
              "key": "AIO_NUM_THREADS",
              "value": "16"
            },
            {
              "key": "AIO_IMPLICIT_FP16_TRANSFORM_FILTER",
              "value": ".*"
            },
            {
              "key": "VIDEO_SRC",
              "value": ""
            },
            {
              "key": "WEBCAM0_SRC",
              "value": "0"
            },
            {
              "key": "WEBCAM1_SRC",
              "value": "2"
            }
          ]
        }
      },
      {
        "name": "whisper",
        "depends_on": [
          "ampere-demo-lite-pool-v1"
        ],
        "exports": [
          "service_url",
          "service_name",
          "internal_dns_name"
        ],
        "recipe": {
          "recipe_id": "ampere_whisper_demo_v1",
          "recipe_mode": "service",
          "deployment_name": "ampere-demo-whisper-v1",
          "recipe_image_uri": "ghcr.io/amperecomputingai/ampere-ai-ref-apps:whisper-0.3.10rc1",
          "recipe_node_shape": "VM.Standard.A2.Flex",
          "recipe_node_selector_arch": "arm64",
          "recipe_use_shared_node_pool": true,
          "recipe_shared_node_pool_selector": "ampere-demo-lite-v1",
          "recipe_container_port": "7863",
          "recipe_host_port": "80",
          "recipe_replica_count": 1,
          "recipe_container_cpu_count": 4,
          "recipe_container_memory_size": 24,
          "recipe_ephemeral_storage_size": 20,
          "recipe_shared_memory_volume_size_limit_in_mb": 1024,
          "recipe_container_env": [
            {
              "key": "CONFIG_FILE",
              "value": "cfg/config.yaml"
            },
            {
              "key": "GRADIO_SERVER_NAME",
              "value": "0.0.0.0"
            },
            {
              "key": "GRADIO_SERVER_PORT",
              "value": "7863"
            },
            {
              "key": "HOST_PORT",
              "value": "7863"
            },
            {
              "key": "INSTANCE_NAME",
              "value": "OCI Ampere"
            },
            {
              "key": "NSTREAMS",
              "value": "1"
            },
            {
              "key": "NTHREADS",
              "value": "16"
            },
            {
              "key": "AIO_NUM_THREADS",
              "value": "16"
            },
            {
              "key": "AIO_IMPLICIT_FP16_TRANSFORM_FILTER",
              "value": ".*"
            }
          ]
        }
      },
      {
        "name": "ollama",
        "depends_on": [
          "ampere-demo-lite-pool-v1"
        ],
        "exports": [
          "service_name",
          "internal_dns_name",
          "service_url"
        ],
        "recipe": {
          "recipe_id": "ampere_ollama_service_demo_v1",
          "recipe_mode": "service",
          "deployment_name": "ampere-demo-ollama-v1",
          "recipe_image_uri": "ghcr.io/amperecomputingai/ollama-ampere:1.0.0-ol9",
          "recipe_node_shape": "VM.Standard.A2.Flex",
          "recipe_node_selector_arch": "arm64",
          "recipe_use_shared_node_pool": true,
          "recipe_shared_node_pool_selector": "ampere-demo-lite-v1",
          "recipe_container_port": "11434",
          "recipe_host_port": "80",
          "recipe_replica_count": 1,
          "recipe_container_cpu_count": 8,
          "recipe_container_memory_size": 32,
          "recipe_ephemeral_storage_size": 40,
          "recipe_shared_memory_volume_size_limit_in_mb": 1024,
          "recipe_container_command": [
            "bash",
            "-lc"
          ],
          "recipe_container_command_args": [
            "ollama serve & sleep 15 && ollama pull \"$OLLAMA_MODEL\" && wait"
          ],
          "recipe_container_env": [
            {
              "key": "OLLAMA_HOST",
              "value": "0.0.0.0:11434"
            },
            {
              "key": "OLLAMA_MODELS",
              "value": "/tmp/ollama-models"
            },
            {
              "key": "OLLAMA_MODEL",
              "value": "llama3.2:1b"
            },
            {
              "key": "OLLAMA_NUM_PARALLEL",
              "value": "1"
            }
          ]
        }
      },
      {
        "name": "llmchat",
        "depends_on": [
          "ampere-demo-lite-pool-v1",
          "ollama"
        ],
        "exports": [
          "service_url",
          "service_name",
          "internal_dns_name"
        ],
        "recipe": {
          "recipe_id": "ampere_open_webui_chat_demo_v1",
          "recipe_mode": "service",
          "deployment_name": "ampere-demo-llmchat-v1",
          "recipe_image_uri": "ghcr.io/open-webui/open-webui:v0.6.40",
          "recipe_node_shape": "VM.Standard.A2.Flex",
          "recipe_node_selector_arch": "arm64",
          "recipe_use_shared_node_pool": true,
          "recipe_shared_node_pool_selector": "ampere-demo-lite-v1",
          "recipe_container_port": "8080",
          "recipe_host_port": "80",
          "recipe_replica_count": 1,
          "recipe_container_cpu_count": 2,
          "recipe_container_memory_size": 8,
          "recipe_ephemeral_storage_size": 20,
          "recipe_shared_memory_volume_size_limit_in_mb": 512,
          "recipe_container_env": [
            {
              "key": "PORT",
              "value": "8080"
            },
            {
              "key": "ENV",
              "value": "dev"
            },
            {
              "key": "VECTOR_DB",
              "value": "chroma"
            },
            {
              "key": "ENABLE_OLLAMA_API",
              "value": "True"
            },
            {
              "key": "OLLAMA_BASE_URL",
              "value": "http://${ollama.internal_dns_name}:80"
            },
            {
              "key": "OLLAMA_BASE_URLS",
              "value": "http://${ollama.internal_dns_name}:80"
            },
            {
              "key": "WEBUI_NAME",
              "value": "Ampere Demo Lite on OCI"
            },
            {
              "key": "WEBUI_AUTH",
              "value": "False"
            },
            {
              "key": "ENABLE_SIGNUP",
              "value": "False"
            },
            {
              "key": "ENABLE_PERSISTENT_CONFIG",
              "value": "False"
            },
            {
              "key": "WEBUI_SECRET_KEY",
              "value": "replace-this-before-production"
            },
            {
              "key": "USE_OLLAMA_DOCKER",
              "value": "false"
            },
            {
              "key": "AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST",
              "value": "30"
            },
            {
              "key": "DEFAULT_MODELS",
              "value": "llama3.2:1b"
            },
            {
              "key": "DEFAULT_PINNED_MODELS",
              "value": "llama3.2:1b"
            }
          ]
        }
      }
    ]
  }
}
